DATA_DIR=./data
MAX_RESUMES=10

# Database — SQLite by default; swap for PostgreSQL/MySQL on any host
DATABASE_URL=sqlite:///./data/resume_iq.db

# LLM Integration (optional — keyword matching used when disabled)
# LLM_PROVIDER choices: openai | anthropic | groq | google | mistral | together
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT=60
